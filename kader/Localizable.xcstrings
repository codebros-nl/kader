    },
    "A layout remembers where the windows of all open apps are. Layouts set to apply automatically are applied when their display arrangement becomes active, for example when you connect a monitor." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een layout onthoudt waar de vensters van alle open apps staan. Automatisch toepassen gebeurt als deze schermopstelling actief wordt, bijvoorbeeld bij het aansluiten van een monitor."
          }
        }
      }
    },
    "Accessibility access not granted" : {
