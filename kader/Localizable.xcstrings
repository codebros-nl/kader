    },
    "%lld windows · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$#@windows@ · %2$@"
          },
          "substitutions": {
            "windows": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg window"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg windows"
                    }
                  }
                }
              }
            }
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$#@windows@ · %2$@"
          },
          "substitutions": {
            "windows": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg venster"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg vensters"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "A layout remembers where the windows of all open apps are. Applying automatically happens when its display arrangement becomes active, for example when you connect a monitor.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een layout onthoudt waar de vensters van alle open apps staan. Automatisch toepassen gebeurt als deze schermopstelling actief wordt, bijvoorbeeld bij het aansluiten van een monitor."
          }
        }
      }
    },
